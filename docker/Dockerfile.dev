FROM ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive

# 基本ツールと wgpu/Vulkan・GLFW/X11 のビルド／実行依存
# mesa-vulkan-drivers は GPU のない環境でのソフトウェア描画にも使用する。
# xvfb-run -a で X11 ウィンドウのヘッドレス検証が可能。
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    pkg-config \
    gcc-12 \
    g++-12 \
    git \
    ca-certificates \
    curl \
    wget \
    gnupg \
    lsb-release \
    software-properties-common \
    python3 \
    python3-dev \
    python3-tk \
    python3-pip \
    libvulkan1 \
    mesa-vulkan-drivers \
    vulkan-tools \
    libx11-dev \
    libxrandr-dev \
    libxinerama-dev \
    libxcursor-dev \
    libxi-dev \
    libxrender-dev \
    xvfb \
    xauth \
    && rm -rf /var/lib/apt/lists/*

# 検証に使用した Rust に固定（edition 2024 対応）。必要に応じ build-arg で変更する。
ARG RUST_VERSION=1.99.1
ENV RUSTUP_HOME=/usr/local/rustup \
    CARGO_HOME=/usr/local/cargo
ENV PATH="${CARGO_HOME}/bin:${PATH}"
RUN curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs -o /tmp/rustup-init.sh && \
    sh /tmp/rustup-init.sh -y --profile minimal --default-toolchain "${RUST_VERSION}" --no-modify-path && \
    rm /tmp/rustup-init.sh && \
    rustup component add rustfmt clippy && \
    rustc --version && cargo --version

# LLVM公式リポジトリから Clang 17 をインストール
# (Ubuntu 22.04標準のClang 14はGCC12のrangesヘッダーと相性が悪いため)
RUN wget -q https://apt.llvm.org/llvm.sh && \
    chmod +x llvm.sh && \
    ./llvm.sh 17 && \
    rm llvm.sh && \
    apt-get install -y clang-tidy-17 clang-format-17 --no-install-recommends && \
    rm -rf /var/lib/apt/lists/*

# update-alternatives でシステム標準のコマンドとして登録
RUN update-alternatives --install /usr/bin/clang clang /usr/bin/clang-17 100 && \
    update-alternatives --install /usr/bin/clang++ clang++ /usr/bin/clang++-17 100 && \
    update-alternatives --install /usr/bin/clang-tidy clang-tidy /usr/bin/clang-tidy-17 100 && \
    update-alternatives --install /usr/bin/clang-format clang-format /usr/bin/clang-format-17 100

# 3. uv のインストール (公式推奨のマルチステージビルド形式でクリーンに取得)
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# ビルドには引き続き GCC 12 を使用
ENV CC=gcc-12 \
    CXX=g++-12 \
    CXXFLAGS="-std=c++20"

WORKDIR /workspace
