{
  "name": "Modern C++ Dev Env",
  "build": { "dockerfile": "../docker/Dockerfile.dev" },
  "initializeCommand": [
    "bash",
    "${localWorkspaceFolder}/.devcontainer/prepare-x11.sh",
    "${localEnv:DISPLAY}",
    "${localEnv:XAUTHORITY}"
  ],
  "containerEnv": {
    "DISPLAY": "${localEnv:DISPLAY}",
    "XAUTHORITY": "/tmp/ad-xauthority",
    "MESA_VK_WSI_DEBUG": "noshm"
  },
  "mounts": [
    "source=/tmp/.X11-unix,target=/tmp/.X11-unix,type=bind,readonly",
    "source=${localWorkspaceFolder}/.devcontainer/.xauthority,target=/tmp/ad-xauthority,type=bind,readonly"
  ],
  "remoteEnv": {
    "UV_PROJECT_ENVIRONMENT": "/workspace/.venv_docker",
    "VIRTUAL_ENV": "/workspace/.venv_docker",
    "PATH": "/workspace/.venv_docker/bin:${containerEnv:PATH}"
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "oderwat.indent-rainbow",
        "ms-azuretools.vscode-docker",
        "esbenp.prettier-vscode",
        "redhat.vscode-yaml",
        "ms-vscode.cpptools-extension-pack"
      ]
    }
  },
  "workspaceMount": "source=${localWorkspaceFolder},target=/workspace,type=bind",
  "workspaceFolder": "/workspace"
}
